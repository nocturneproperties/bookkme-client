{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(gradle:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(grep:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/spotless-stop.sh",
            "timeout": 300,
            "statusMessage": "Checking Spotless..."
          }
        ]
      }
    ]
  }
}
